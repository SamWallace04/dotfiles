{
  "position": "top",
  "layer": "bottom",
  "height": 16,
  "margin-top": 0,
  "margin-bottom": 0,
  "margin-left": 0,
  "margin-right": 0,
  "modules-left": ["cpu", "memory", "disk", "disk#data", "disk#data2"],
  "modules-center": ["hyprland/workspaces", "clock", "custom/launcher"],
  "modules-right": ["tray", "network", "pulseaudio"],
  // Modules configuration
  "clock": {
    "format": " {:%H:%M}",
    "tooltip": "true",
    "tooltip-format": "<tt><big>{calendar}</big></tt>",
    "calendar": {
      "mode-mon-col": 4,
      "weeks-pos": "left",
      "on-scroll": 1,
      "on-click-right": "mode",
      "format": {
        "months": "<span color='#f9f002'><b>{}</b></span>",
        "weekdays": "<span color='#ff9800'><b>{}</b></span>",
        "today": "<span color='#000000' background='#8ae66e'><b>{}</b></span>",
      },
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down",
    },
    "format-alt": " {:%d/%m}",
  },

  "hyprland/workspaces": {
    "active-only": false,
    "all-outputs": true,
    "disable-scroll": false,
    "on-scroll-up": "hyprctl dispatch workspace -1",
    "on-scroll-down": "hyprctl dispatch workspace +1",
    "format": "{icon}",
    "on-click": "activate",
    "format-icons": {
      //			"1": "一",
      //			"2": "二",
      //			"3": "三",
      //			"4": "四",
      //			"5": "五",
      "urgent": "",
      "active": "<span color=\"#298d29\"></span>",
      "default": "󰧞",
      "sort-by-number": true,
    },
  },
  "hyprland/window": {
    "separate-outputs": true,
  },

  "memory": {
    "format": "󰍛 {}%",
    "format-alt": "󰍛 {used}/{total} GiB",
    "interval": 5,
  },

  "cpu": {
    "format": "󰻠 {usage}%",
    "format-alt": "󰻠 {avg_frequency} GHz",
    "interval": 5,
  },

  "disk": {
    "format": "󰋊 {free}",
    "format-alt": "󰋊 {}%",
    "interval": 5,
  },

  "disk#data": {
    "format": " {free}",
    "format-alt": " {}%",
    "interval": 5,
    "path": "/media/data/",
  },

  "disk#data2": {
    "format": " {free}",
    "format-alt": " {}%",
    "interval": 5,
    "path": "/media/data2/",
  },

  "network": {
    "format-wifi": "󰤨",
    //"format-ethernet": " {ifname}: Aesthetic",
    "format-ethernet": "",
    //"format-linked": " {ifname} (No IP)",
    "format-disconnected": "󰤭",
    "format-alt": " {ifname}: {ipaddr}/{cidr}",
    "tooltip-format": "{essid}",
    "on-click-right": "nm-connection-editor",
  },

  "tray": {
    "icon-size": 16,
    "spacing": 5,
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"],
    },
    "on-click": "bash ~/.config/waybar/scripts/volume mute",
    "scroll-step": 5,
    "on-click-right": "pavucontrol",
  },
  "custom/launcher": {
    "format": "<span color=\"#89dceb\">󰣇</span>",
    "on-click": "bash $HOME/.config/rofi/launchers/type-6/launcher.sh",
    "on-click-right": "bash $HOME/.config/rofi/powermenu/type-6/powermenu.sh",
  },
}
